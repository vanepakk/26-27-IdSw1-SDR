@startuml DiagramaDeContexto000
title Estados del Gestor Web
hide empty description
skinparam shadowing false
skinparam nodesep 70
skinparam ranksep 110
left to right direction

state DISPONIBLE
state DIRECTORIO_RAIZ
state DIRECTORIO_ABIERTO
state SUBDIRECTORIO_ABIERTO
state VISTA_ABIERTA

[*] --> DISPONIBLE
DISPONIBLE --> DIRECTORIO_RAIZ
DIRECTORIO_RAIZ --> DIRECTORIO_ABIERTO
DIRECTORIO_ABIERTO --> SUBDIRECTORIO_ABIERTO
SUBDIRECTORIO_ABIERTO --> VISTA_ABIERTA
DIRECTORIO_ABIERTO --> VISTA_ABIERTA
DIRECTORIO_RAIZ --> DIRECTORIO_RAIZ
DIRECTORIO_ABIERTO --> DIRECTORIO_ABIERTO
VISTA_ABIERTA --> VISTA_ABIERTA
SUBDIRECTORIO_ABIERTO <-- VISTA_ABIERTA
DIRECTORIO_ABIERTO <-- SUBDIRECTORIO_ABIERTO
DIRECTORIO_RAIZ <-- DIRECTORIO_ABIERTO
DISPONIBLE <-- DIRECTORIO_RAIZ
@enduml
