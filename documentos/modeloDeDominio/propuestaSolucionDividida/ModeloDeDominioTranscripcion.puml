@startuml
title Modelo del dominio - FUNIBER
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam roundcorner 5
skinparam nodesep 65
skinparam ranksep 75
skinparam packageStyle rectangle
hide circle
hide empty members
class "Universidad" as U
class "Convenio" as C
class "País" as PS {
    idioma
    denominación
}
package "FUNIBER" as BF {
class "FUNIBER (Organización)" as F
class "Investigación" as INV
class "Proyecto de investigación" as I
class "Artículo científico" as AC
class "Actividad" as A
class "Obra cultural" as O
class "Evento internacional" as E
class "Noticia" as N
class "Anuncio" as AN
class "Publicación" as P
class "Programa académico" as PA
class "Beca" as B
class "Titulación" as T {
    nombre de titulación
}
class "Marco normativo" as M
class "Usuario" as US
class "Formulario de información" as FO
}
package "GESTOR-WEB" as BW {
class "Directorio raíz" as R
class "Directorio" as D
class "Subdirectorio" as S
class "Vista" as V
class "Componente" as CO {
    tipo
}
class "Contenido" as CT
class "Administrador" as AD
class "Editor" as ED
class "Versión" as VE {
    estado
}
enum "Tipo de componente" as TC {
    formulario
    contacto
}
enum "Estado" as ES {
    publicado
    no publicado
}
}
U -right-> C : vincula
C -right-> F : establece
F -down-> INV : financia
INV -down-> I : produce
I -down-> AC : genera
F -down-> A : organiza
F -down-> O : presenta
O -down-> E : organiza
E -down-> N : genera
F -down-> PA : ofrece
F -down-> AN : emite
AC --> N : sustenta
AC --> P : puede derivar
A --> P : se asocia a
N --> P : puede derivar
AN --> P : puede derivar
PA -down-> B : ofrece
PA -down-> T : recibe
A --> US : es vista por
O --> US : es vista por
PA --> US : es visto por
US --> P : ve
US --> FO : rellena
T -right-> PS : varía según
M -right-> PS : se rige según
R "1" -down-> "*" D : contiene
D "1" -down-> "*" S : contiene
PS "1" -right- "1" D : corresponde a
D --> "1" V : tiene como principal
S "*" -down-> "*" V : muestra
V "*" -down-> "*" CO : se compone de
CO -down-> CT : contiene
V "1" --> "1..*" VE : tiene
CO "1" --> "1..*" VE : tiene
CT "1" -down-> "1..*" VE : tiene
AD "1" --> "*" D : crea
AD --> "*" S : crea
AD --> CO : edita
AD --> VE : publica
ED --> CT : cambia
AD --|> ED
CO ..> TC
VE ..> ES
BF -[norank]right-> BW : es gestionado por
CT -[norank]left- BF : recibe
U -[hidden]right- C
C -[hidden]right- BF
T -[hidden]right- PS
PS -[hidden]right- D
INV -[hidden]right- A
A -[hidden]right- O
O -[hidden]right- AN
AN -[hidden]right- PA
R -[hidden]right- AD
@enduml
