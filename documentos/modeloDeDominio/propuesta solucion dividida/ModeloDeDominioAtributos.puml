@startuml
title Modelo del dominio - FUNIBER
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam classAttributeIconSize 0
skinparam roundcorner 5
skinparam nodesep 75
skinparam ranksep 85
skinparam packageStyle rectangle
hide circle
hide empty members
class "Universidad" as U {
    nombre
}
class "Convenio" as C {
    denominación
    fecha de inicio
    fecha de fin
}
class "País" as PS {
    idioma
    denominación
}
package "FUNIBER" as BF {
class "FUNIBER (Organización)" as F {
    nombre
}
class "Investigación" as INV {
    tema
    objetivo
}
class "Proyecto de investigación" as I {
    título
    fecha de inicio
    estado
}
class "Artículo científico" as AC {
    título
    autoría
    fecha de publicación
}
class "Actividad" as A {
    nombre
    tipo de actividad
    fecha
}
class "Obra cultural" as O {
    título
    autoría
    tipo de obra
}
class "Evento internacional" as E {
    nombre
    fecha
    lugar
}
class "Noticia" as N {
    título
    fecha
    texto
}
class "Anuncio" as AN {
    título
    fecha
    vigencia
}
class "Publicación" as P {
    título
    fecha de publicación
    idioma
}
class "Programa académico" as PA {
    denominación
    modalidad
    duración
}
class "Beca" as B {
    denominación
    condiciones
}
class "Titulación" as T {
    nombre de titulación
}
class "Marco normativo" as M {
    denominación
    normativa aplicable
}
class "Usuario" as US {
    nombre
    correo electrónico
}
class "Formulario de información" as FO {
    nombre de contacto
    correo electrónico
    consulta
}
}
package "GESTOR-WEB" as BW {
class "Directorio raíz" as R {
    nombre
}
class "Directorio" as D {
    nombre
}
class "Subdirectorio" as S {
    nombre
}
class "Vista" as V {
    nombre
}
class "Componente" as CO {
    tipo
}
class "Contenido" as CT {
    texto
    idioma
}
class "Administrador" as AD {
    nombre
    correo electrónico
}
class "Editor" as ED {
    nombre
    correo electrónico
}
class "Versión" as VE {
    estado
    número de versión
    fecha de modificación
}
enum "Tipo de componente" as TC {
    formulario
    contacto
}
enum "Estado" as ES {
    publicado
    no publicado
}
}
U -right-> C : vincula
C -right-> F : establece
F -down-> INV : financia
INV -down-> I : produce
I -down-> AC : genera
F -down-> A : organiza
F -down-> O : presenta
O -down-> E : organiza
E -down-> N : genera
F -down-> PA : ofrece
F -down-> AN : emite
AC --> N : sustenta
AC --> P : puede derivar
A --> P : se asocia a
N --> P : puede derivar
AN --> P : puede derivar
PA -down-> B : ofrece
PA -down-> T : recibe
A --> US : es vista por
O --> US : es vista por
PA --> US : es visto por
US --> P : ve
US --> FO : rellena
T -right-> PS : varía según
M -right-> PS : se rige según
R "1" -down-> "*" D : contiene
D "1" -down-> "*" S : contiene
PS "1" -right- "1" D : corresponde a
D --> "1" V : tiene como principal
S "*" -down-> "*" V : muestra
V "*" -down-> "*" CO : se compone de
CO -down-> CT : contiene
V "1" --> "1..*" VE : tiene
CO "1" --> "1..*" VE : tiene
CT "1" -down-> "1..*" VE : tiene
AD "1" --> "*" D : crea
AD --> "*" S : crea
AD --> CO : edita
AD --> VE : publica
ED --> CT : cambia
AD --|> ED
CO ..> TC
VE ..> ES
BF -[norank]right-> BW : es gestionado por
CT -[norank]left- BF : recibe
U -[hidden]right- C
C -[hidden]right- BF
T -[hidden]right- PS
PS -[hidden]right- D
INV -[hidden]right- A
A -[hidden]right- O
O -[hidden]right- AN
AN -[hidden]right- PA
R -[hidden]right- AD
@enduml
